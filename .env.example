# Copie este arquivo para `.env` e preencha com as credenciais reais do Supabase.
# Só valores seguros para expor no bundle do app (chave anon/publishable) devem
# entrar aqui — NUNCA a service_role key do Supabase.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co/rest/v1
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Número de WhatsApp do suporte (com DDI+DDD, ex: 5511999998888) — usado pelo atalho
# "Enviar ID por WhatsApp" na tela de Configurações, quando o cliente precisa de liberação
# manual de licença. Opcional: se ausente, o botão fica desabilitado.
EXPO_PUBLIC_SUPPORT_WHATSAPP_PHONE=5511999998888
